# ==============================================================
# IELTS Speaking AI Coach — Environment Configuration
# ==============================================================

# Application Environment
ENVIRONMENT=development  # development | production
APP_NAME="IELTS Speaking AI Coach"

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:9b
OLLAMA_TIMEOUT=120.0
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=1024
OLLAMA_THINK=false

# Cloud Fallback (DeepSeek)
# Note: Keep DEEPSEEK_API_KEY confidential on the backend. NEVER bundle in mobile APK.
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30.0

# Routing Preference: auto | local_only | cloud_only
MODEL_ROUTING_PREFERENCE=auto

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./data/app.db
# Cloud PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Speech-to-Text (Whisper)
WHISPER_MODEL=base.en
AUDIO_DIR=./data/audio
# Optional English phoneme-level assessor sidecar (enable with the pronunciation profile).
PRONUNCIATION_ASSESSOR_URL=

# Production Security & Authentication
# For direct local development authentication stays disabled. Docker Compose
# forces it on; replace this placeholder with a generated random secret first.
API_KEY_ENABLED=false
API_KEY=your_secret_production_api_key_here
AUTH_SECRET=your_random_auth_signing_secret_minimum_32_characters
ACCESS_TOKEN_TTL_MINUTES=720

# Optional server-side crash/error reporting. Request bodies and user PII are disabled.
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# CORS & Network
# Native Android clients do not use browser CORS. Add exact web origins here.
CORS_ORIGINS=http://localhost
ENABLE_SECURITY_HEADERS=true
