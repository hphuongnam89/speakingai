{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ielts-learning-edition:v2:lesson",
  "title": "Lesson authoring record; not a learner-facing API payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "skill", "objective", "competency_ids", "prerequisites", "estimated_minutes", "provenance", "steps"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "validated", "pending_review", "approved", "published", "retired"]},
    "skill": {"enum": ["listening", "reading", "writing", "speaking"]},
    "objective": {"type": "string", "minLength": 1},
    "competency_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "estimated_minutes": {"type": "integer", "minimum": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "ai_assisted", "reviewer_id", "reviewed_at"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "ai_assisted": {"type": "boolean"},
        "reviewer_id": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "instruction"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["explain", "worked_example", "guided", "independent", "feedback", "self_repair", "transfer", "review"]},
          "instruction": {"type": "string", "minLength": 1},
          "stimulus": {"type": "string"},
          "author_answer": {"type": "string"},
          "evidence_quote": {"type": "string"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "explain"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "worked_example"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "guided"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "independent"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "feedback"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "self_repair"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "transfer"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "review"}}, "required": ["kind"]}}
      ]
    }
  }
}
