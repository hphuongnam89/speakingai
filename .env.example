# ==============================================================
# IELTS Speaking AI Coach — Environment Configuration
# ==============================================================

# Application Environment
ENVIRONMENT=development  # development | production
APP_NAME="IELTS Speaking AI Coach"

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:9b
OLLAMA_TIMEOUT=30.0

# Cloud Fallback (DeepSeek)
# Note: Keep DEEPSEEK_API_KEY confidential on the backend. NEVER bundle in mobile APK.
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30.0

# Routing Preference: auto | local_only | cloud_only
MODEL_ROUTING_PREFERENCE=auto

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./data/app.db
# Cloud PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Speech-to-Text (Whisper)
WHISPER_MODEL=base.en
AUDIO_DIR=./data/audio

# Production Security & Authentication
# If API_KEY_ENABLED=true, requests must provide header "X-API-Key" or "Authorization: Bearer <token>"
API_KEY_ENABLED=false
API_KEY=your_secret_production_api_key_here

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# CORS & Network
CORS_ORIGINS=*
ENABLE_SECURITY_HEADERS=true
